@model Minecraft.Models.ViewModels.DatabaseViewModel

@{
    ViewData["Title"] = "Minecraft Database";
}

<style>
    /* Custom style để làm cho bảng không quá rộng */
    .table-responsive-custom {
        max-width: 100%;
        overflow-x: auto;
    }
</style>

<div class="container mt-5">
    <h1 class="display-4 text-primary">📜 Minecraft Database</h1>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🧍 Danh Sách Người Chơi (@(Model.Players?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Player</th>
                    <th>Tên nhân vật</th>
                    <th>Email</th>
                    <th>Password</th>
                    <th>XP</th>
                    <th>Wallet Balance</th>
                    <th>Game Mode</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Players != null)
                {
                    foreach (var player in Model.Players)
                    {
                        <tr>
                            <td>@player.PlayerID</td>
                            <td>@player.CharacterName</td>
                            <td>@player.Email</td>
                            <td>@player.Password</td>
                            <td>@player.ExperiencePoints</td>
                            <td>@player.WalletBalance</td>
                            <td>@player.GameMode.ModeName</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Chưa có dữ liệu Người chơi.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🕹️ Danh Sách Chế Độ Chơi (@(Model.GameModes?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Game Mode</th>
                    <th>Tên Chế Độ</th>
                    <th>Mô Tả</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.GameModes != null)
                {
                    foreach (var mode in Model.GameModes)
                    {
                        <tr>
                            <td>@mode.ModeID</td>
                            <td>@mode.ModeName</td>
                            <td>@(string.IsNullOrEmpty(mode.Description) ? "N/A" : mode.Description)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center">Chưa có dữ liệu Chế độ chơi.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">📦 Danh Sách Vật Phẩm (@(Model.Items?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Item</th>
                    <th>Tên Vật Phẩm</th>
                    <th>Loại</th>
                    <th>Giá</th>
                    <th>URL Hình Ảnh</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null)
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ItemID</td>
                            <td>@item.ItemName</td>
                            <td>@(string.IsNullOrEmpty(item.ItemType) ? "N/A" : item.ItemType)</td>
                            <td>@item.Price</td>
                            <td>@(string.IsNullOrEmpty(item.ImageURL) ? "Không có" : item.ImageURL)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Chưa có dữ liệu Vật phẩm.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🚗 Danh Sách Phương Tiện (@(Model.Vehicles?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Vehicle</th>
                    <th>Tên Phương Tiện</th>
                    <th>Loại</th>
                    <th>Giá</th>
                    <th>URL Hình Ảnh</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Vehicles != null)
                {
                    foreach (var vehicle in Model.Vehicles)
                    {
                        <tr>
                            <td>@vehicle.VehicleID</td>
                            <td>@vehicle.VehicleName</td>
                            <td>@(string.IsNullOrEmpty(vehicle.VehicleType) ? "N/A" : vehicle.VehicleType)</td>
                            <td>@vehicle.Price</td>
                            <td>@(string.IsNullOrEmpty(vehicle.ImageURL) ? "Không có" : vehicle.ImageURL)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Chưa có dữ liệu Phương tiện.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🛒 Danh Sách Giao Dịch Mua Hàng (@(Model.Purchases?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Purchase</th>
                    <th>Người Chơi</th>
                    <th>Vật Phẩm</th>
                    <th>Phương Tiện</th>
                    <th>Số lượng</th>
                    <th>Ngày Mua</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Purchases != null)
                {
                    foreach (var purchase in Model.Purchases)
                    {
                        <tr>
                            <td>@purchase.PurchaseID</td>
                            <td>@purchase.Player.CharacterName</td>
                            <td>@(purchase.ItemID.HasValue? purchase.Item.ItemName : "N/A")</td>
                            <td>@(purchase.VehicleID.HasValue? purchase.Vehicle.VehicleName : "N/A")</td>
                            <td>@purchase.Amount</td>
                            <td>@purchase.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Chưa có dữ liệu Giao dịch Mua hàng.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🎯 Danh Sách Nhiệm Vụ (@(Model.Quests?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Quest</th>
                    <th>Tên Nhiệm Vụ</th>
                    <th>XP Thưởng</th>
                    <th>Mô Tả</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Quests != null)
                {
                    foreach (var quest in Model.Quests)
                    {
                        <tr>
                            <td>@quest.QuestID</td>
                            <td>@quest.QuestName</td>
                            <td>@quest.RewardExp</td>
                            <td>@(string.IsNullOrEmpty(quest.Description) ? "N/A" : quest.Description)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center">Chưa có dữ liệu Nhiệm vụ.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">📋 Trạng Thái Nhiệm Vụ Của Người Chơi (@(Model.PlayerQuests?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Quest Status</th>
                    <th>Người Chơi</th>
                    <th>Nhiệm Vụ</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PlayerQuests != null)
                {
                    foreach (var pq in Model.PlayerQuests)
                    {
                        <tr>
                            <td>@pq.PlayerQuestID</td>
                            <td>@pq.Player.CharacterName</td>
                            <td>@pq.Quest.QuestName</td>
                            <td>@pq.Status</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center">Chưa có dữ liệu Trạng thái Nhiệm vụ.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🧟 Danh Sách Quái Vật (@(Model.Monsters?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Monster</th>
                    <th>Tên Quái Vật</th>
                    <th>Máu (HP)</th>
                    <th>Sát Thương</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Monsters != null)
                {
                    foreach (var monster in Model.Monsters)
                    {
                        <tr>
                            <td>@monster.MonsterID</td>
                            <td>@(string.IsNullOrEmpty(monster.MonsterName) ? "N/A" : monster.MonsterName)</td>
                            <td>@monster.Health</td>
                            <td>@monster.AttackDamage</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center">Chưa có dữ liệu Quái vật.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <hr />

    <h2 class="mt-5 mb-3 text-secondary">🔪 Lịch Sử Tiêu Diệt Quái Vật (@(Model.MonsterKills?.Count ?? 0))</h2>
    <div class="table-responsive-custom">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>ID Kill</th>
                    <th>Người Chơi</th>
                    <th>Quái Vật</th>
                    <th>XP Thưởng</th>
                    <th>Thời Gian</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MonsterKills != null)
                {
                    foreach (var kill in Model.MonsterKills)
                    {
                        <tr>
                            <td>@kill.KillID</td>
                            <td>@kill.Player.CharacterName</td>
                            <td>@kill.Monster.MonsterName</td>
                            <td>@kill.RewardExp</td>
                            <td>@kill.KillTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center">Chưa có dữ liệu Tiêu diệt Quái vật.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>