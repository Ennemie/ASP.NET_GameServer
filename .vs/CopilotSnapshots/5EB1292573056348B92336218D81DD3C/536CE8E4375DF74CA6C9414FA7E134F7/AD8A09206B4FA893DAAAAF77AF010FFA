@model IEnumerable<Minecraft.Models.Player>

@{
    ViewData["Title"] = "Quản lý Người Chơi";
}

<style>
    /* Tái sử dụng style của bạn */
    .table-responsive-custom {
        max-width: 100%;
        overflow-x: auto;
    }

    .action-column {
        white-space: nowrap;
        width: 1%;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 text-primary">👮 Quản Lý Người Chơi</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            + Thêm Người Chơi
        </a>
    </div>

    <hr />

    <div class="table-responsive-custom mt-4">
        <table class="table table-striped table-hover table-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tên nhân vật</th>
                    <th>Email</th>
                    <th>Password</th>
                    <th>XP</th>
                    <th>Số dư ví</th>
                    <th>Chế độ chơi</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.PlayerID</td>
                            <td class="fw-bold text-primary">@item.CharacterName</td>
                            <td>@item.Email</td>
                            <td>@item.Password</td>
                            <td>@item.ExperiencePoints</td>
                            <td>@item.WalletBalance</td>
                            <td>
                                @if (item.GameMode != null)
                                {
                                    <span class="badge bg-info text-dark">@item.GameMode.ModeName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa chọn</span>
                                }
                            </td>
                            <td class="action-column">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.PlayerID" class="btn btn-sm btn-warning">Sửa</a>
                                    <a asp-action="Details" asp-route-id="@item.PlayerID" class="btn btn-sm btn-info">Chi tiết</a>
                                    <a asp-action="Delete" asp-route-id="@item.PlayerID" class="btn btn-sm btn-danger">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <h5 class="text-muted">Chưa có dữ liệu người chơi nào.</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>